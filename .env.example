# AgriSense AI Configuration Template
# Copy this file to .env and configure your environment

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="AgriSense AI"
VERSION="1.2.0"

# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000"

# AI / LLM Configuration (Optional - Falls back to deterministic regional rules if not set)
AI_PROVIDER=rule_engine_fallback # Options: gemini, openai, local, rule_engine_fallback
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# External Public Data Feeds (Mocked by default for offline hackathon reliability)
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api/v1/forecast
AGMARKNET_API_ENDPOINT=https://agmarknet.gov.in/api/v1/prices
DATA_GOV_API_KEY=
